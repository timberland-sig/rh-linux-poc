# Global variables

# Copr repository settings
# Usualy, these values won't be used and thus need not be changed.
COPR_PROJECT=NBFT
COPR_USER=johnmeneghini

# This is the system UUID for the target-vm
# The TARGET_SYS_UUID is generated with TARGET_SYS_UUID="$(uuidgen)"
TARGET_SYS_UUID="a53caec2-eb2d-4bca-819e-f2bbfb10e1fa"

# This is the system UUID for the host-vm
# This HostNQN appears in the target-vm/tcp.json file and in the host-vm/discover_target.sh file
HOST_SYS_UUID="f8131bac-cdef-4165-866b-5998c1e67890"

# These are the Namespace identifiers and Subsystem NQN for the Linux Ctrl soft target.
# See the target-vm/tcp.json.in file for more information.
SUBNQN="nqn.2014-08.org.nvmexpress:uuid:0c468c4d-a385-47e0-8299-6e95051277db"
NSNGUID="ace42e00-1510-2fce-2ee4-ac0000000001"
NSUUID="bee9c2b7-1761-44b5-a4e6-0f690498a94b"

# NVMe/TCP subsystem port used by the target and host VMs
SUBSYS_PORT="4420"

# Serial numbers for nvme disks, used by target-vm/install.sh
# Generated with SN=$(hexdump -vn8 -e'4/4 "%08X" 1 "\n"' /dev/urandom)
# The generate_serial_number() function from vm-lib/common.sh does just this
SN0="7E1250DCD4B0A268"
SN1="3A44B3E2177CA6D9"
SN2="97A28D5D3ECDE7F2"
SN3="2AF557665E8B11C0"
SN4="5B36AC547362E851"

# The names of bridge devices must be fresh to your testbed.
BRIDGE0_NAME="br0"
BRIDGE1_NAME="br1"
BRIDGE2_NAME="br2"

# The names of virtual bridge devices must be fresh to your testbed.
# These are only used with the virtual gateway setup.
VIRT_TARGET_BRIDGE_NAME0="virbr_target0"
VIRT_TARGET_BRIDGE_NAME1="virbr_target1"
VIRT_TARGET_BRIDGE_NAME2="virbr_target2"

VIRT_HOST_BRIDGE_NAME0="virbr_host0"
VIRT_HOST_BRIDGE_NAME1="virbr_host1"
VIRT_HOST_BRIDGE_NAME2="virbr_host2"

# Note that TARGET_MAC1 and HOST_MAC1 are used with DHCP and must be unique to
# your testbed. Use the ./gen_macaddr.py script and replace these values
# for your testbed.

TARGET_MAC1="00:16:3E:36:38:90"
HOST_MAC1="00:16:3E:3E:3A:3E"

# These port numbers are used to access port 22 (SSH) of the VMs.
# Make sure they are not used by a different process in your testbed or change them here.
TARGET_PORT="5555"
HOST_PORT="5556"

# The Following MAC addresses are static. The must be changed when you are using a public bridged
# network and can only be left alone when $BRIDGE1_NAME and $BRIDGE2_NAME the networks are private.
# If these are not changed with ./setup.sh env before using a bridged network, collisions with other
# host and target-vms on the same network can occur.

TARGET_MAC2="EA:EB:D3:56:89:56"
TARGET_MAC3="EA:EB:D3:57:89:57"
HOST_MAC2="EA:EB:D3:58:89:58"
HOST_MAC3="EA:EB:D3:59:89:59"

# IMPORTANT: These two static CIDR IPv4 addresses MUST be set by the user
# when the virtual gateway is to be set.
ROUTER_CIDR2=""
ROUTER_CIDR3=""

# The following CIDRs can be changed to assign the host-vm and target-vm new addresses on
# a public bridged network.  These can be left alone when using a private virtual network.
TARGET_CIDR2="192.168.101.20/24"
TARGET_CIDR3="192.168.110.20/24"

HOST_CIDR2="192.168.101.30/24"
HOST_CIDR3="192.168.110.30/24"

HOSTGW_CIDR2="192.168.101.1/24"
HOSTGW_CIDR3="192.168.110.1/24"

# DNS servers provided via DHCP (comma-separated)
DNS_SERVERS="8.8.8.8, 8.8.4.4"

# If true, the host-vm 'start-local' Makefile target will include the
# NBFT EFI variables (vm_vars.fd) when booting. By default, local boot
# does not use NBFT and boots from the local disk only.
LOCAL_HOST_VM_USE_NBFT=false

# These are the base URLs of mirrors from which ISO files are downloaded.
MIRROR_CENTOS="https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/iso/"
MIRROR_FEDORA="https://download.fedoraproject.org/pub/fedora/linux/"

# EDK2 repository settings for building OVMF from source (setup.sh install-edk2)
EDK2_REPO_URL="${EDK2_REPO_URL:-https://github.com/timberland-sig/edk2.git}"
#EDK2_REPO_BRANCH="${EDK2_REPO_BRANCH:-rel/timberland_1_0_1}"
#EDK2_REPO_BRANCH="${EDK2_REPO_BRANCH:-timberland_1_0_1-john-nospdk}"
#EDK2_REPO_BRANCH="${EDK2_REPO_BRANCH:-timberland_main}"
EDK2_REPO_BRANCH="${EDK2_REPO_BRANCH:-timberland_devel_103}"

#OVMF_ZIP="timberland-ovmf-release-edk2-stable201903-4950-g72976af.zip"
#OVMF_ZIP="timberland-ovmf-release-edk2-stable202605-46-g4e9e9e6.zip"
#OVMF_ZIP="timberland-ovmf-release-edk2-stable202605-86-g106f7dd.zip"
OVMF_ZIP="timberland-ovmf-release-edk2-stable202605-89-ge721658.zip"

#OVMF_URL="https://github.com/timberland-sig/edk2/releases/download/release-edk2-stable201903-4950-g72976af/"
#OVMF_URL="https://github.com/timberland-sig/edk2/releases/download/release-edk2-stable202605-46-g4e9e9e6/"
#OVMF_URL="https://github.com/timberland-sig/edk2/releases/download/release-edk2-stable202605-86-g106f7dd/"
OVMF_URL="https://github.com/timberland-sig/edk2/releases/download/release-edk2-stable202605-89-ge721658/"
