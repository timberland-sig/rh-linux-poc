#!/bin/bash
#
# Template for the per-VM remote network setup script. Rendered with
# envsubst by vm-lib/build-remote-netsetup.sh into a ready-to-run script
# with no arguments - do not run this .in file directly.

set -e

to_lower() {
    echo "$1" | awk '{print tolower($0)}'
}

mac2iface() {
	local macaddr=$1
    find /sys/class/net -mindepth 1 ! -name lo -execdir sh -c "MAC=\$(cat {}/address 2>/dev/null); if [ \"\$MAC\" = \"$macaddr\" ]; then echo \"\$(basename {})\"; fi" \;
}

# TPL_* below are the only envsubst placeholders in this file. Everything
# derived from them (VMNAME, MAC2, IP2, IF2, iface, ip_config, ...) is a
# plain runtime shell variable with a *different* name on purpose: envsubst
# does a blind whole-file text substitution, not just a single "declaration"
# line, so a runtime variable reused with the same name as a placeholder
# (e.g. a bare "$MAC2" in a later mac2iface call) would also get replaced
# with the raw, un-lowercased template value - silently bypassing to_lower()
# below and breaking MAC matching against /sys/class/net, which the kernel
# always reports in lowercase.
VMNAME="${TPL_VMNAME}"
MAC1="$(to_lower "${TPL_MAC1}")"
MAC2="$(to_lower "${TPL_MAC2}")"
MAC3="$(to_lower "${TPL_MAC3}")"
IP1="${TPL_IP1}"
IP2="${TPL_IP2}"
IP3="${TPL_IP3}"
# GATEWAY/ROUTES2/ROUTES3/DNS_SERVERS are only non-empty in static router
# mode - see setup_iface() below for how they're applied (or ignored).
GATEWAY="${TPL_GATEWAY}"
ROUTES2="${TPL_ROUTES2}"
ROUTES3="${TPL_ROUTES3}"
DNS_SERVERS="${TPL_DNS_SERVERS}"
# See WORKAROUND_NBFT_STATIC_ROUTING_BUG in README.md / apply_nbft_workaround()
# below.
NBFT_WORKAROUND="${TPL_NBFT_WORKAROUND}"

IF1="$(mac2iface "$MAC1")"
IF2="$(mac2iface "$MAC2")"
IF3="$(mac2iface "$MAC3")"

echo "<$IF2> <$IF3>"
if [ '(' -z $IF2 ')' -o '(' -z $IF3 ')' ] ; then
    if [ -z "$IF2" ] ; then
        BAD_MAC="$MAC2"
    else
        BAD_MAC="$MAC3"
    fi
    echo "Failed to find a network interface with MAC address $BAD_MAC!"
fi

# WORKAROUND_NBFT_STATIC_ROUTING_BUG (see README.md): NBFT connections
# generated by the firmware boot table carry their own default gateway. In
# static router mode, that competes with the primary interface's default
# route and breaks general connectivity. This replaces the NBFT connection's
# default gateway with a plain static route to the NVMe/TCP target subnet
# reachable through it (the same $routes value setup_iface() would otherwise
# have applied to this interface had it not been nbft-owned), preserving
# target reachability without contending for the default route. Caller
# (setup_iface) only invokes this when NBFT_WORKAROUND=1. Leaves the
# connection fully untouched if not in static mode (empty $routes), or if
# it has no gateway to begin with.
apply_nbft_workaround() {
	local uuid=$1
	local routes=$2

	if [ -z "$routes" ]; then
		return
	fi

	local gateway
	gateway=$(nmcli -g ipv4.gateway con show "$uuid" 2>/dev/null)
	if [ -z "$gateway" ]; then
		return
	fi

	echo "Workaround: replacing NBFT default gateway $gateway on $uuid with static route(s): $routes"
	nmcli con modify "$uuid" ipv4.never-default yes ipv4.gateway "" ipv4.routes "$routes"
	nmcli con up "$uuid"
}

setup_iface() {
	local iface=$1
	local ip_config=$2
	local never_default=${3:-yes}
	local gateway=${4:-}
	local routes=${5:-}
	local dns=${6:-}

	if [ -z "$iface" ]; then
		return
	fi

	if [ -z "$ip_config" ]; then
		echo "Skipping interface $iface: no IP configuration provided"
		return
	fi

	# If an nbft connection owns this device, leave its addressing alone -
	# see apply_nbft_workaround() for the one thing it may still change.
	local nbft_uuid
	nbft_uuid=$(nmcli -t -g UUID,NAME con show 2>/dev/null | while IFS=: read -r uuid name; do
		case "$name" in nbft*) ;; *) continue ;; esac
		ifname=$(nmcli -g connection.interface-name con show "$uuid" 2>/dev/null) || continue
		if [ "$ifname" = "$iface" ]; then
			echo "$uuid"
			break
		fi
	done)
	if [ -n "$nbft_uuid" ]; then
		if [ "$NBFT_WORKAROUND" = "1" ]; then
			apply_nbft_workaround "$nbft_uuid" "$routes"
		fi
		return
	fi

	# Remove any pre-existing connections on this device
	nmcli -t -g UUID con show 2>/dev/null | while read -r uuid; do
		ifname=$(nmcli -g connection.interface-name con show "$uuid" 2>/dev/null) || continue
		if [ "$ifname" = "$iface" ]; then
			nmcli con delete uuid "$uuid" 2>/dev/null || true
		fi
	done

	if [ "$ip_config" = "dhcp" ]; then
		nmcli con add \
			type ethernet \
			con-name "${iface}-dhcp" \
			ifname "$iface" \
			ipv4.method auto \
			ipv4.dhcp-timeout 30 \
			ipv4.never-default "$never_default" \
			ipv4.may-fail no \
			ipv6.method shared \
			connection.autoconnect yes \
			connection.autoconnect-priority 10 \
			connection.autoconnect-retries 2

		nmcli con up "${iface}-dhcp"
	else
		# Static-mode module: gateway/routes/dns are plain nmcli property
		# values (data), not shell commands - nmcli accepts a full
		# multi-value property directly on `con add`, same as this
		# codebase already does for DNS_SERVERS's comma-separated list.
		local -a extra_args=()
		if [ -n "$gateway" ]; then
			echo "Setting default gateway on $iface -> $gateway"
			extra_args+=(ipv4.gateway "$gateway")
		fi
		if [ -n "$routes" ]; then
			echo "Setting static routes on $iface: $routes"
			extra_args+=(ipv4.routes "$routes")
		fi
		if [ -n "$dns" ]; then
			echo "Setting DNS servers on $iface: $dns"
			extra_args+=(ipv4.dns "$dns" ipv4.ignore-auto-dns yes)
		fi

		nmcli con add \
			type ethernet \
			con-name "${iface}-static" \
			ifname "$iface" \
			ipv4.addresses "$ip_config" \
			ipv4.method manual \
			ipv4.never-default "$never_default" \
			ipv6.method shared \
			connection.autoconnect yes \
			connection.autoconnect-priority 10 \
			"${extra_args[@]}"

		nmcli con up "${iface}-static"
	fi
}

# IF1 is the router-facing (gateway) interface: it must be allowed to hold
# the default route, so never-default is "no". GATEWAY/ROUTES2/ROUTES3/
# DNS_SERVERS are only non-empty in static router mode, and are ignored by
# the dhcp branch above whenever an interface's IP config is "dhcp" (e.g.
# the SLIRP/no-br0 case forces IP1 to "dhcp" even in static mode, so the
# gateway/DNS override is safely skipped for that interface without any
# extra flag needed).
setup_iface "$IF1" "$IP1" no  "$GATEWAY" ""         "$DNS_SERVERS"
setup_iface "$IF2" "$IP2" yes ""         "$ROUTES2" "$DNS_SERVERS"
setup_iface "$IF3" "$IP3" yes ""         "$ROUTES3" "$DNS_SERVERS"

nmcli g hostname "$VMNAME"

ip -h -c -o -br address show
ip route show
resolvectl status | grep -A 5 "DNS Servers" || true

cat hosts.txt >> /etc/hosts
if [ -f $HOME/hostid ] ; then
	/bin/cp -f hostid /etc/nvme	# 'cp' may be aliased to 'cp -i'
fi


if [[ $(grep EDITOR ~/.bashrc) =~ vim ]] ; then
   echo "$EDITOR"
else
	echo "EDITOR=vim; export EDITOR;" >> ~/.bashrc
	echo "alias ipshow='ip -h -c -o -br address show'" >> ~/.bashrc
	echo "alias ipmac=\"ip -o link show | cut -d ' ' -f 2,20\"" >> ~/.bashrc
	sed -i "s/# %wheel/%wheel/g" /etc/sudoers
fi

dnf install -y nvme-cli nvmetcli libnvme
