{

"Dhcp4": {
    "interfaces-config": {
        "interfaces": [ ${INTERFACES} ]
    },

    "control-socket": {
        "socket-type": "unix",
        "socket-name": "kea4-ctrl-socket"
    },

    "lease-database": {
        "type": "memfile",
        "lfc-interval": 3600
    },

    "expired-leases-processing": {
        "reclaim-timer-wait-time": 10,
        "flush-reclaimed-timer-wait-time": 25,
        "hold-reclaimed-time": 3600,
        "max-reclaim-leases": 100,
        "max-reclaim-time": 250,
        "unwarned-reclaim-cycles": 5
    },

    "renew-timer": 900,
    "rebind-timer": 1800,
    "valid-lifetime": 3600,

    "option-data": [
        {
            "name": "default-ip-ttl",
            "data": "0xf0"
        },
        {
            "name": "domain-name-servers",
            "data": "${DNS_SERVERS}"
        }
    ],

    "client-classes": [
        {
            "name": "voip",
            "test": "substring(option[60].hex,0,6) == 'Aastra'",
            "next-server": "192.0.2.254",
            "server-hostname": "hal9000",
            "boot-file-name": "/dev/null"
        }
    ],

    "subnet4": [
        {
            "id": 1,
            "subnet": "${ROUTER_TO_TARGET_NET1}",
            "pools": [ { "pool": "${ROUTER_TO_TARGET_POOL1}" } ],
            "interface": "${ROUTER_TO_TARGET_IFACE1}",
            "option-data": [
                {
                    "name": "routers",
                    "data": "${ROUTER_TO_TARGET_IP1}"
                }
            ],
            "reservations": [
                {
                    "hw-address": "${TARGET_MAC1}",
                    "ip-address": "${ROUTER_TO_TARGET_RESIP1}"
                }
            ]
        },
        {
            "id": 2,
            "subnet": "${ROUTER_TO_TARGET_NET2}",
            "pools": [ { "pool": "${ROUTER_TO_TARGET_POOL2}" } ],
            "interface": "${ROUTER_TO_TARGET_IFACE2}",
            "option-data": [
                // Classless Static Routes (Option 121)
                {
                    "name": "classless-static-route",
                    "code": 121,
                    "data": "${ROUTER_TO_HOST_NET2} - ${ROUTER_TO_TARGET_IP2}, ${BRIDGE1_NET} - ${ROUTER_TO_TARGET_IP2}"
                }
            ],
            "reservations": [
                {
                    "hw-address": "${TARGET_MAC2}",
                    "ip-address": "${ROUTER_TO_TARGET_RESIP2}"
                }
            ]
        },
        {
            "id": 3,
            "subnet": "${ROUTER_TO_TARGET_NET3}",
            "pools": [ { "pool": "${ROUTER_TO_TARGET_POOL3}" } ],
            "interface": "${ROUTER_TO_TARGET_IFACE3}",
            "option-data": [
                // Classless Static Routes (Option 121)
                {
                    "name": "classless-static-route",
                    "code": 121,
                    "data": "${ROUTER_TO_HOST_NET3} - ${ROUTER_TO_TARGET_IP3}, ${BRIDGE2_NET} - ${ROUTER_TO_TARGET_IP3}"
                }
            ],
            "reservations": [
                {
                    "hw-address": "${TARGET_MAC3}",
                    "ip-address": "${ROUTER_TO_TARGET_RESIP3}"
                }
            ]
        },
        {
            "id": 4,
            "subnet": "${ROUTER_TO_HOST_NET1}",
            "pools": [ { "pool": "${ROUTER_TO_HOST_POOL1}" } ],
            "interface": "${ROUTER_TO_HOST_IFACE1}",
            "option-data": [
                {
                    "name": "routers",
                    "data": "${ROUTER_TO_HOST_IP1}"
                }
            ],
            "reservations": [
                {
                    "hw-address": "${HOST_MAC1}",
                    "ip-address": "${ROUTER_TO_HOST_RESIP1}"
                }
            ]
        },
        {
            "id": 5,
            "subnet": "${ROUTER_TO_HOST_NET2}",
            "pools": [ { "pool": "${ROUTER_TO_HOST_POOL2}" } ],
            "interface": "${ROUTER_TO_HOST_IFACE2}",
            "option-data": [
                // Classless Static Routes (Option 121)
                {
                    "name": "classless-static-route",
                    "code": 121,
                    "data": "${ROUTER_TO_TARGET_NET2} - ${ROUTER_TO_HOST_IP2}, ${BRIDGE1_NET} - ${ROUTER_TO_HOST_IP2}"
                }
            ],
            "reservations": [
                {
                    "hw-address": "${HOST_MAC2}",
                    "ip-address": "${ROUTER_TO_HOST_RESIP2}"
                }
            ]
        },
        {
            "id": 6,
            "subnet": "${ROUTER_TO_HOST_NET3}",
            "pools": [ { "pool": "${ROUTER_TO_HOST_POOL3}" } ],
            "interface": "${ROUTER_TO_HOST_IFACE3}",
            "option-data": [
                // Classless Static Routes (Option 121)
                {
                    "name": "classless-static-route",
                    "code": 121,
                    "data": "${ROUTER_TO_TARGET_NET3} - ${ROUTER_TO_HOST_IP3}, ${BRIDGE2_NET} - ${ROUTER_TO_HOST_IP3}"
                }
            ],
            "reservations": [
                {
                    "hw-address": "${HOST_MAC3}",
                    "ip-address": "${ROUTER_TO_HOST_RESIP3}"
                }
            ]
        }
    ],

    "loggers": [
        {
            "name": "kea-dhcp4",
            "output-options": [
                {
                    "output": "syslog"
                }
            ],
            "severity": "INFO",
            "debuglevel": 0
        }
    ]
}
}
